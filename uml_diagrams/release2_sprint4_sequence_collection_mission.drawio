  <diagram id="r2-s4-seq" name="Release 2 - Sprint 4 - Missions de collecte">
    <mxGraphModel dx="1500" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Diagramme de séquence — Création, affectation et suivi d'une mission de collecte" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="1100" height="40" as="geometry"/></mxCell>

        <mxCell id="actor1" value="Intercommunalité" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="120" height="90" as="geometry"/></mxCell>
        <mxCell id="ui" value="Interface de gestion" style="shape=umlLifeline;perimeter=perimeterRectangle;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="90" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="api" value="API FastAPI" style="shape=umlLifeline;perimeter=perimeterRectangle;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="90" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="db" value="Base de données" style="shape=umlLifeline;perimeter=perimeterRectangle;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="150" height="100" as="geometry"/></mxCell>
        <mxCell id="notif" value="Service Notification / FCM" style="shape=umlLifeline;perimeter=perimeterRectangle;html=1;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="collector" value="Collecteur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1250" y="100" width="120" height="90" as="geometry"/></mxCell>

        <mxCell id="l1" style="shape=line;dashed=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="320" y="190" width="0" height="850" as="geometry"/></mxCell>
        <mxCell id="l2" style="shape=line;dashed=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="0" height="850" as="geometry"/></mxCell>
        <mxCell id="l3" style="shape=line;dashed=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="800" y="190" width="0" height="850" as="geometry"/></mxCell>
        <mxCell id="l4" style="shape=line;dashed=1;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1065" y="190" width="0" height="850" as="geometry"/></mxCell>

        <mxCell id="m1" value="1. Saisir la mission et choisir le collecteur / groupe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=1;" edge="1" parent="1" source="actor1" target="ui"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="260" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="2. POST /collector-zones/assignments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m3" value="3. Créer CollectorZoneAssignment (status=pending)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m4" value="4. Confirmer la création" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="db" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m5" value="5. Déclencher notification assignment" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="api" target="notif"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m6" value="6. Push : nouvelle mission" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="notif" target="collector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m7" value="7. Consulter les missions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="collector" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m8" value="8. GET assignments du collecteur" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m9" value="9. Liste des missions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="db" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m10" value="10. Choisir la mission" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;" edge="1" parent="1" source="api" target="collector"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m11" value="11. Mettre à jour : pending → in_progress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="collector" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m12" value="12. UPDATE assignment.status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m13" value="13. Fin de collecte : done ou cancelled + notes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="collector" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="m14" value="14. Enregistrer completed_at / notes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell>
